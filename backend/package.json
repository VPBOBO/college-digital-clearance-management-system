{
  "name": "cdcms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDCMS first-slice API and PostgreSQL services",
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/migrate.js",
    "db:seed": "node src/seed.js",
    "db:reset:test": "node scripts/reset-test-database.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test test/domain.test.js test/auth.test.js test/db-safety.test.js test/demo-password-reset.test.js",
    "test:integration": "node --test test/integration.test.js",
    "db:reset-demo-passwords": "node scripts/reset-demo-passwords.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "dotenv": "16.4.7",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
