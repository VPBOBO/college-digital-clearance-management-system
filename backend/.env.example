# Copy this file to .env and replace the local PostgreSQL credentials.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Set ALLOW_LAN=YES only when deliberately exposing the API on a trusted private LAN.
ALLOW_LAN=NO
DATABASE_URL=postgres://cdcms_app:CHANGE_THIS_LOCAL_PASSWORD@127.0.0.1:5432/cdcms_dev
# Required for the local development API and schema migration; host must be loopback and DB name end in _dev.
ALLOW_DEV_DATABASE=YES
ALLOW_DEV_MIGRATIONS=YES
SESSION_TTL_HOURS=8
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
COOKIE_SECURE=false
# Required safety opt-in for the local demo seed; DATABASE_URL must target a loopback host and a database ending in _dev.
ALLOW_DEMO_SEED=YES
# PUBLIC LOCAL DEMO CREDENTIAL ONLY. Never use in production.
# All newly created fictional demo accounts use this password.
SEED_PASSWORD=test123

# Separate explicit opt-in for changing passwords of existing demo accounts.
# Keep NO except when deliberately running db:reset-demo-passwords.
ALLOW_DEMO_PASSWORD_RESET=NO
